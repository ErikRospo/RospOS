#include <stdio.h>


void _err_handler(){
    // @r1 is "Just give me the actual value of r1."
    int r1=@r1;
    // print_hex(@r1);
    print_string("Error:");
    print_hex(r1);
    print_string("\n");
    int error_type=(r1&0xFFFF0000)>>16;
    if (error_type==1){
        print_string("Invalid opcode: ");
        print_hex_char((r1&0xF0)>>4);
        print_hex_char(r1&0xF);
        int opcode_family=r1&0xF0;
        print_char(" ");
        if (opcode_family==0){
            print_string("R-type");            
        } else if (opcode_family==1){
            print_string("I-type");
        } else if (opcode_family==2){
            print_string("Load/Store");
        } else if (opcode_family==3){
            print_string("Branch");
        } else if (opcode_family==4){
            print_string("Jump");
        } else if (opcode_family==5){
            print_string("System");
        } else if (opcode_family==15){
            print_string("Special");
        } else {
            print_string("Unknown opcode family");
        }
        print_string(": ");
        print_hex_char(r1&0xF);
    } else if (error_type==2){
        print_string("Invalid Operation");
    } else {
        print_string("Unknown Error. Something is seriously wrong.");
    }
    print_char("\n");
    print_string("PC=");
    // Consume the fault frame before logging calls push their caller saves.
    int saved_pc=__pop();
    print_hex(saved_pc);
    print_char("\n");
    for (int i=1;i<=15;i++){
        print_string("R");
        print_hex_char(i);
        print_string("=");
        int saved_register=__pop();
        print_hex(saved_register);
        print_char("\n");
    }
    __break();
}

char print_hex_buffer[9];
char *hex_chars = "0123456789ABCDEF";

inline void print_hex(int input)
{
    for (int i = 0; i < 8; i++)
    {
        print_hex_buffer[7 - i] = hex_chars[input & 0xF];
        input = input >> 4;
    }
    print_hex_buffer[8]=0;
    print_string(print_hex_buffer);
}
inline void print_hex_char(int input){
    print_char(hex_chars[input & 0xF]);
}
