inline int add(int a, int b)
{
    return a + b;
}

int fibonnaci_recursive(int i){
    if (i<=0){
        return 0;
    }
    if (i<=2){
        return 1;
    }
    int j=fibonnaci_recursive(i-1);
    int k=fibonnaci_recursive(i-2);
    return j+k;
}
void display_test()
{
    draw_string_to_display("Hello, RospOS!", 0, 0, 0x3F);

    draw_string_to_display("Green", 0, 24, 0x0C);
    draw_string_to_display("Red", 0, 32, 0x30);
    draw_string_to_display("Blue", 0, 40, 0x07);
    draw_string_to_display("Yellow", 0, 48, 0x3C);
    draw_string_to_display("Cyan", 0, 56, 0x0F);
    draw_string_to_display("Magenta", 0, 64, 0x33);
    draw_string_to_display("White", 0, 72, 0x3F);
}
void fs_test()
{
    initialize_filesystem();
    write_file("example.txt\0", "Hello, RospOS filesystem!\0");
    char device_info[512];
    read_block(0xFFFFFFFF, device_info); // Read from the special block to get device info
    draw_string_to_display(device_info, 0, 8, 0x3F);
    char file_contents[512];
    read_file("example.txt\0", file_contents);
    draw_string_to_display(file_contents, 0, 16, 0x3F);
}
void rand_block_display_test()
