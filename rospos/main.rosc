void malloc_test()
{
    int malloc_test_size = 256; // Size of memory to allocate
    char *malloc_test_ptr = (char *)malloc(malloc_test_size);
    int read_success = 1;
    /* Rosc has no null, so we check for 0 instead. */
    if (malloc_test_ptr != 0)
    {
        // Successfully allocated memory, now we can use it.
        for (int i = 0; i < malloc_test_size; i++)
        {
            malloc_test_ptr[i] = (char)i; // Fill with some data
        }
        // Optionally, we can read back the data to verify.
        for (int i = 0; i < malloc_test_size; i++)
        {
            if (malloc_test_ptr[i] != (char)i)
            {
                read_success = 0; // Data mismatch
            }
        }
        if (read_success)
        {
            draw_string_to_display("Malloc test passed!\0", 0, 96, 0x3F);
        }
        else
        {
            draw_string_to_display("Malloc test failed!\0", 0, 96, 0x3F);
        }
        free(malloc_test_ptr); // Free the allocated memory
    }
    /* Rosc has no null, so we check for 0 instead. */
    else
    {
        draw_string_to_display("Malloc test failed: MEM!\0", 0, 96, 0x3F);
    }

    char *int_to_str_test_buffer = (char *)malloc(12); // Buffer to hold the string representation
    if (int_to_str_test_buffer != 0)
    {
        int test_value = -123456;
        int_to_str_buf(test_value, int_to_str_test_buffer);
        draw_string_to_display("Int to str test: \0", 0, 104, 0x3F);
        draw_string_to_display(int_to_str_test_buffer, 0, 112, 0x3F);
        free(int_to_str_test_buffer); // Free the allocated buffer
    }
    else
    {
        draw_string_to_display("Int to str test failed: MEM!\0", 0, 104, 0x3F);
    }
}

void math_test()
{
    char *infix_expr = "3+4*2/(1-5)";
    write_to_buffer("Infix: \0", 0);
    write_to_buffer(infix_expr, 8);
    update_buffer();
    char *rpn_buffer = (char *)malloc(512);
    if (!rpn_buffer)
    {
        write_to_buffer("Memory allocation failed for RPN buffer.\0", 16);
        update_buffer();
        return;
    }
    infix_to_rpn(infix_expr, rpn_buffer);
    write_to_buffer("RPN: \0", 32);
    write_to_buffer(rpn_buffer, 38);
    update_buffer();

    write_to_buffer("Result: \0", 64);
    int result = evaluate_rpn(rpn_buffer);
    char result_str[16];
    int_to_str_buf(result, result_str);
    write_to_buffer(result_str, 72);
    update_buffer();
}
void time_test()
{
    char *time_str = fmt_unix_time(get_unix_time());
    draw_string_to_display(time_str, 10, 56, 0x3F);
    print_string("Current time: \n");
    print_string(time_str);
    update_buffer();
}
void recursive_test(){
    char *recursive_test_buffer = (char *)malloc(12); // Buffer to hold the string representation
    if (recursive_test_buffer != 0)
    {
        int test_value = fibonnaci_recursive(5);
        int_to_str_buf(test_value, recursive_test_buffer);
        draw_string_to_display("Fibonacci number: \0", 0, 104, 0x3F);
        draw_string_to_display(recursive_test_buffer, 0, 112, 0x3F);
        free(recursive_test_buffer); // Free the allocated buffer
    }
    else
    {
        draw_string_to_display("Fibonacci number test failed: MEM!\0", 0, 104, 0x3F);
    }
}

